.vscode

# Build output
bin/
coverage.out

# SQLite databases created at runtime (GoFr derives the file from DB_NAME)
*.db
*.db-shm
*.db-wal

# Administered database connection (contains a password)
configs/datasource.json
cmd/configs/datasource.json
bin/configs/datasource.json

# The production environment file. It holds the database password, and the
# example next to it is what belongs in the repository instead.
deploy/.env

# Written by the compose check in ci.yml and by anybody running that check by
# hand. It holds invented passwords rather than real ones, which is exactly why
# it must not be committed: a file of plausible-looking credentials in a
# deployment folder is one somebody eventually copies.
deploy/.env.ci

# Personal config override. GoFr loads it automatically when APP_ENV is unset,
# which makes it the right place for a local database or a debug log level -
# and the wrong thing to commit, because it silently applies to everyone.
cmd/configs/.local.env
bin/configs/.local.env

# Release binaries, built into the work tree by the release workflow.
dist/

# The Windows resource, generated per build from build/versioninfo.json.in.
# The toolchain links any .syso in the package directory, so a committed one
# would be linked with whatever version it was written with, for ever.
*.syso
