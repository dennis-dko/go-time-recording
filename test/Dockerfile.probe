# Runs the connection probe from inside the compose network.
#
# Useful when a check passes from the host but fails for the application, which
# is almost always a name or a port that only resolves on one side of the
# container boundary. From in here the service names apply and the published
# ports do not, so the difference shows up immediately.
#
#   docker compose --profile all up -d
#   docker compose --profile probe run --rm probe
#
# Built from the repository root so the probe shares the application's go.mod
# and therefore its drivers: a pass here means those exact drivers connected.
FROM golang:1.26.5-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -trimpath -o /out/probe ./test/probe

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=build /out/probe /usr/local/bin/probe

ENTRYPOINT ["probe"]
