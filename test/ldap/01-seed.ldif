# Seed for the throwaway test directory.
#
# The entries below are not just "some users to bind as". Each one stands for a
# case the synchronisation has to get right, and together they make the failure
# modes reproducible instead of theoretical:
#
#   alice    an ordinary account; the baseline
#   bob      the rename case - change his mail address and re-run the sync. He
#            must survive, because matching is on entryUUID, not on mail. Before
#            that fix he would have been deleted along with his recorded hours.
#   carol    no mail address at all; must be skipped rather than guessed at
#   dave     outside the people subtree; must not appear when the base DN is
#            narrowed to ou=people, which is how a wrong base DN is spotted
#   service  the bind account, which is not a person and holds no hours
#
# entryUUID is not set here: the server assigns it, which is exactly why it is
# the right thing to match on. Passwords are plain text because this directory
# is disposable; nothing here belongs anywhere near a real deployment.

# The suffix has to be the first entry: slapadd rejects a child whose parent
# does not exist yet. cn=admin is not here - it is the rootdn from slapd.conf,
# which slapd answers for without it being stored.

dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example Organisation
dc: example

dn: ou=people,dc=example,dc=com
objectClass: organizationalUnit
ou: people

dn: ou=contractors,dc=example,dc=com
objectClass: organizationalUnit
ou: contractors

dn: ou=services,dc=example,dc=com
objectClass: organizationalUnit
ou: services

# The service account the application binds as to search. It has no mail
# address, so the synchronisation skips it - a directory bind user must never
# turn into a person with a timesheet.
dn: cn=service,ou=services,dc=example,dc=com
objectClass: inetOrgPerson
cn: service
sn: Account
userPassword: gtr-test-password

dn: uid=alice,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: alice
cn: Alice Anderson
sn: Anderson
mail: alice@example.com
userPassword: alice-password

# Rename this one's mail address to prove a rename is not a departure:
#   ldapmodify -x -H ldap://localhost:5389 \
#     -D 'cn=admin,dc=example,dc=com' -w gtr-test-password <<'EOF'
#   dn: uid=bob,ou=people,dc=example,dc=com
#   changetype: modify
#   replace: mail
#   mail: robert.builder@example.com
#   EOF
# Then run the sync preview: bob must not be listed for deletion.
dn: uid=bob,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: bob
cn: Bob Builder
sn: Builder
mail: bob@example.com
userPassword: bob-password

# No mail attribute on purpose. The application cannot key an account on
# nothing, so this entry is skipped - silently, but deliberately.
dn: uid=carol,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: carol
cn: Carol Carpenter
sn: Carpenter
userPassword: carol-password

# Deliberately outside ou=people. With the base DN set to the whole tree this
# account appears; narrow it to ou=people and it vanishes. That difference is
# how a base DN that is too wide or too narrow becomes visible.
dn: uid=dave,ou=contractors,dc=example,dc=com
objectClass: inetOrgPerson
uid: dave
cn: Dave Driver
sn: Driver
mail: dave@example.com
userPassword: dave-password
