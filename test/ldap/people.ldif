# The people in the throwaway test directory.
#
# Mounted into /seed/extra of the image built from deploy/ldap, which creates
# the suffix, ou=people, ou=services and the bind account before this is loaded.
# So this file holds only what is particular to testing: five entries, each
# standing for a case the synchronisation has to get right.
#
#   alice    an ordinary account; the baseline
#   bob      the rename case - change his mail address and re-run the sync. He
#            must survive, because matching is on entryUUID, not on mail. Before
#            that fix he would have been deleted along with his recorded hours.
#   carol    no mail address at all; must be skipped rather than guessed at
#   dave     outside the people subtree; must not appear when the base DN is
#            narrowed to ou=people, which is how a wrong base DN is spotted
#
# The bind account is the fifth, and it is not here: the image seeds a
# cn=service with no mail attribute of its own, which is the same case this file
# used to make - a directory bind user must never turn into a person with a
# timesheet - and duplicating it here would fail the import on the second copy.
#
# entryUUID is not set on any of them: the server assigns it, which is exactly
# why it is the right thing to match on. Passwords are plain text because this
# directory is disposable; nothing here belongs anywhere near a real deployment.
#
# __SUFFIX__ is substituted by the entrypoint, so this reads correctly whatever
# LDAP_SUFFIX the compose file sets rather than hard-coding one and silently
# importing nothing when it changes.

# Not created by the image, because a deployment has no use for it. It exists
# here to hold somebody outside ou=people.
dn: ou=contractors,__SUFFIX__
objectClass: organizationalUnit
ou: contractors

dn: uid=alice,ou=people,__SUFFIX__
objectClass: inetOrgPerson
uid: alice
cn: Alice Anderson
sn: Anderson
mail: alice@example.com
userPassword: alice-password

# Rename this one's mail address to prove a rename is not a departure:
#   ldapmodify -x -H ldap://localhost:5389 \
#     -D 'cn=admin,dc=example,dc=com' -w gtr-test-password <<'EOF'
#   dn: uid=bob,ou=people,dc=example,dc=com
#   changetype: modify
#   replace: mail
#   mail: robert.builder@example.com
#   EOF
# Then run the sync preview: bob must not be listed for deletion.
dn: uid=bob,ou=people,__SUFFIX__
objectClass: inetOrgPerson
uid: bob
cn: Bob Builder
sn: Builder
mail: bob@example.com
userPassword: bob-password

# No mail attribute on purpose. The application cannot key an account on
# nothing, so this entry is skipped - silently, but deliberately.
dn: uid=carol,ou=people,__SUFFIX__
objectClass: inetOrgPerson
uid: carol
cn: Carol Carpenter
sn: Carpenter
userPassword: carol-password

# Deliberately outside ou=people. With the base DN set to the whole tree this
# account appears; narrow it to ou=people and it vanishes. That difference is
# how a base DN that is too wide or too narrow becomes visible.
dn: uid=dave,ou=contractors,__SUFFIX__
objectClass: inetOrgPerson
uid: dave
cn: Dave Driver
sn: Driver
mail: dave@example.com
userPassword: dave-password
