# Staging. Overlays .env; only the differences belong here.
#
# Loaded when APP_ENV=staging.

# A staging instance is a real deployment reachable by real people, so it gets
# the same transport as production - with Let's Encrypt's test authority, whose
# certificates browsers do not trust but whose rate limits are far looser.
#
# TLS_DOMAINS has to be set in the environment: it is per-deployment, and
# TLS_ENABLED without it only logs an error and continues on plain HTTP.
#TLS_ENABLED=true
#TLS_STAGING=true
