## App
APP_NAME=go-time-recording
APP_VERSION=0.0.1
LOG_LEVEL=INFO
HTTP_PORT=8000
METRICS_PORT=2121
SHUTDOWN_GRACE_PERIOD=30s

## Database
# SQLite keeps a deployment to a single binary plus one data file. Point
# DB_DIALECT at postgres/mysql (and fill in the host settings) to run against
# a database server instead.
DB_DIALECT=sqlite
DB_NAME=go-time-recording

# Only used by the server dialects:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL_MODE=disable
# DB_MAX_IDLE_CONNECTION=2
# DB_MAX_OPEN_CONNECTION=0

## Application
# Serve the embedded web interface. Set to false to run headless as an API.
UI_ENABLED=true

## Authentication and permissions
# Sign-in and role checks. Users authenticate with their email address and
# password; what they may do comes from their role.
# Setting this to false gives EVERY caller full administrative access - only do
# that for a throwaway local trial.
AUTH_ENABLED=true

# On first start the built-in administrator admin@local is created with the
# password "changeme123" and must change it before the application can be used.

# How long a sign-in stays valid before the user has to authenticate again.
SESSION_LIFETIME=12h

# Nightly sweep that submits time entries left open too long. Empty disables it.
AUTO_CLOSE_SCHEDULE=0 2 * * *
AUTO_CLOSE_AFTER_DAYS=14

# Instance-wide cap on the hours one user may book on a single day. Each user
# can set a lower personal cap, and a daily target that drives their overtime.
MAX_DAILY_HOURS=24

## Transport security
# Serve HTTPS with certificates obtained automatically from Let's Encrypt.
# The host must be reachable from the internet on TLS_REDIRECT_PORT, which is
# where the ACME challenge is answered.
TLS_ENABLED=true

# Comma separated. Certificates are only ever issued for the names listed here.
# TLS_DOMAINS=time.example.com
# TLS_EMAIL=admin@example.com

TLS_PORT=443
TLS_REDIRECT_PORT=80
TLS_CACHE_DIR=configs/certs

# Use Let's Encrypt's test authority while setting things up: browsers do not
# trust those certificates, but the rate limits are far looser.
TLS_STAGING=false

# How long browsers should refuse plain HTTP for this host. Only ever sent
# over a connection that already is HTTPS.
HSTS_MAX_AGE=8760h

## Rate limiting
# Applies to sign-in attempts and API-token requests, per client per window.
# Ordinary browsing by a signed-in user is not limited.
RATE_LIMIT=30
RATE_LIMIT_WINDOW=1m

## Tracing (optional)
# TRACE_EXPORTER=
# TRACER_URL=
# TRACER_RATIO=
