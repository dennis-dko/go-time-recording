# Base configuration.
#
# GoFr reads this file first, then overlays .$APP_ENV.env on top of it. The
# files beside this one therefore hold only what actually differs, and this is
# the single place a default is written down.
#
# Precedence, lowest to highest:
#
#   1. this file
#   2. .$APP_ENV.env  (or .local.env when APP_ENV is unset)
#   3. real environment variables - docker compose, systemd, the shell
#   4. configs/datasource.json, if the Settings screen has written one
#
# The last two are why a deployment needs no file edits at all.
#
# ---------------------------------------------------------------------------
#
# BOOTSTRAP - settable only here or in the environment. These decide how the
# process starts, so an application that has not started cannot administer
# them; and getting one wrong must not be fixable only from a screen it takes
# away. AUTH_ENABLED switched off from the interface would open the instance to
# anyone, with no way back in.
#
# STARTING VALUES - the setup wizard and Settings administer these while the
# application runs, and what is stored there wins. The values here are what a
# fresh installation begins with.
#
# AT THE NEXT START - administered in the application, but stored rather than
# applied, because the framework reads them while starting up: the database
# connection, and the metrics and tracing settings below. What is stored wins
# over what is here, from the next start onwards.
#
# Deliberately absent: the timezone and the LDAP connection. Both are
# administered entirely in the application, and a second place to write them
# would only disagree with the first.

## App
APP_NAME=Time Recording
APP_VERSION=0.0.1
HTTP_PORT=8000

# How much the process writes: DEBUG, INFO, NOTICE, WARN, ERROR or FATAL.
# Anything else is read as INFO rather than refused.
#
# Administered under Settings as well, where what is saved wins over what is
# here from the next start onwards. Not switchable while running: the framework
# can change a logger's level, but it does so by assigning to a field every
# request goroutine reads without synchronisation.
LOG_LEVEL=INFO
SHUTDOWN_GRACE_PERIOD=30s

# The Prometheus endpoint, on a port of its own. 0 switches it off.
#
# The port stays here rather than in the interface on purpose: the framework
# refuses to start when something already holds it, so a port that was free when
# it was saved and taken by the next start would stop the application - and the
# screen that could correct it with it. Settings can only switch the endpoint
# off, which cannot fail.
#
# Worth knowing before exposing it: this port asks for no password, is not
# covered by TLS, and serves Go's profiling endpoints under /debug/pprof/
# alongside the metrics.
METRICS_PORT=2121

## Database - bootstrap
# What everything else is stored in, including the settings the wizard writes.
#
# Deliberately empty. With a default here the application would silently come up
# on a throwaway SQLite file, someone would configure an installation on it -
# accounts, projects, recorded hours - and only discover which database they had
# been using when they tried to move to a real one. Switching then points the
# application at an empty database: the password change, the timezone and the
# instance title are all left behind, and start-up recreates the administrator
# with the initial password from the documentation.
#
# So with nothing configured the binary serves the installer instead of the
# application, and will not start until a connection has been chosen and proven
# to work. The installer writes it to configs/datasource.json, which overrides
# whatever is here from then on.
#
# Setting DB_DIALECT here or in the environment skips the installer, which is how
# a container deployment configures itself - see deploy/compose.yaml.
DB_DIALECT=
DB_NAME=

# Only used by the server dialects:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL_MODE=disable
# DB_MAX_IDLE_CONNECTION=2
# DB_MAX_OPEN_CONNECTION=0

## Application - bootstrap
# Serve the embedded web interface. false runs the binary headless as an API,
# and removes the interface that would turn it back on.
UI_ENABLED=true

# Sign-in and role checks. false gives EVERY caller full administrative access.
# Only for a throwaway local trial, and never administrable from the interface.
AUTH_ENABLED=true

# On first start the built-in administrator admin@local is created with the
# password "changeme123". The setup wizard requires it to be changed before
# anything else can be used.

## Transport security - bootstrap
# The listener is bound at start-up, so a wrong value here makes the instance
# unreachable rather than merely wrong.
#
# TLS_DOMAINS is required when TLS_ENABLED is true and has no sensible default.
# Without it the application logs an error and continues on plain HTTP, so
# enabling TLS without naming a domain achieves nothing.
TLS_ENABLED=false
# TLS_DOMAINS=time.example.com
# TLS_EMAIL=ops@example.com

TLS_PORT=443
TLS_REDIRECT_PORT=80
TLS_CACHE_DIR=configs/certs

# Let's Encrypt's test authority: browsers do not trust those certificates, but
# the rate limits are far looser while setting things up.
TLS_STAGING=false

# How long browsers refuse plain HTTP for this host. Only ever sent over a
# connection that already is HTTPS - over plain HTTP it could lock a host out of
# working at all.
HSTS_MAX_AGE=8760h

## Scheduled jobs - bootstrap
# Cron jobs are registered once at start-up and cannot be re-registered while
# running, which is why the schedules stay here while their parameters do not.
# Empty disables the job.

# A synchronisation run DELETES accounts the directory no longer holds,
# together with their recorded time, private projects and tokens. That cannot be
# undone, so it is empty by default: an administrator can still start a run by
# hand, and the Settings screen offers a preview first.
# Administered under Settings as well, beside the buttons that run it by hand,
# where what is saved wins over this from the next start onwards. Not switchable
# while running: a scheduler is built while the application starts.
# LDAP_SYNC_SCHEDULE=0 4 * * *

## Starting values - administered under Settings once running
# Changing any of these in the interface takes effect within seconds and does
# not need a restart. What is set there wins over what is here.
SESSION_LIFETIME=12h
MAX_DAILY_HOURS=24
RATE_LIMIT=30
RATE_LIMIT_WINDOW=1m

# Refuses a synchronisation that would remove more than this share of the
# directory-backed accounts - the guard against a truncated or misfiltered
# directory answer reading as a mass departure. 0 disables the check.
LDAP_SYNC_MAX_DELETE_RATIO=0.5

## Tracing (optional)
# Off unless an exporter is named. Administered under Settings as well, where
# what is saved wins over what is here from the next start onwards - so set it
# in one place or the other, not both.
#
# TRACE_EXPORTER is otlp or jaeger. TRACER_URL is the collector as host:port,
# without a scheme: the exporter speaks OTLP over gRPC, and a "http://" in front
# is read as part of the host name and resolves nothing. TRACER_RATIO is the
# share of traces recorded, between 0 and 1, and defaults to all of them.
#
# TRACE_EXPORTER=otlp
# TRACER_URL=jaeger:4317
# TRACER_RATIO=1
