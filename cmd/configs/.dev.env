# Development. Overlays .env; only the differences belong here.
#
# Loaded when APP_ENV=dev, which `task dev` sets.

# Every request logged with its trace id, which is what makes a misbehaving
# call findable. Too noisy for a real deployment.
#
# The only file that still names a level: .env leaves it to the telemetry card
# under Settings, and "follow the configuration file" on that card means this
# line. A level chosen there is put into the environment before the framework
# starts, so it beats this from the next start onwards.
#
# It stays here because a development run has no stored setting to follow yet,
# and wants the noise from the first line of the first start.
LOG_LEVEL=DEBUG
