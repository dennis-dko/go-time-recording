# Copy to configs/.env next to the downloaded binary and edit what you need.
#
# The manual that explains what to do with it is OPERATIONS.md, beside this file.
#
#   mkdir -p configs
#   cp .env.binary.example configs/.env
#   chmod 600 configs/.env
#
# For a container deployment use .env.example instead: that one is read by
# docker compose and carries the handful of values compose itself needs. This
# one is read by the process, and lists what this application looks at, with
# the value that applies when the variable is absent.
#
# It is not everything the process reads. GoFr reads its own configuration out
# of the same file and knows about far more than this application wires up.
# The framework's variables are here where they can still change what this
# deployment does - GOFR_TELEMETRY first, because it is the only one that
# reaches the internet by itself - and the last section names the remainder in
# a line each rather than in sections that would suggest they matter.
#
# Nothing here has to be set. The binary runs with this whole file missing: with
# no database configured it serves its installer, and everything below already
# has the default that is written beside it. It exists so that "which knob do I
# turn" has an answer that is not "read the source".
#
# Where the values come from, lowest to highest:
#
#   1. this file
#   2. .$APP_ENV.env beside it (or .local.env when APP_ENV is unset), if present
#   3. real environment variables - systemd, the shell
#   4. configs/datasource.json, written by the installer and by Settings
#
# Anything the running application can change under Settings is stored in the
# database, and what is stored there wins from the next start onwards. Setting
# such a value here therefore only decides what a fresh installation starts
# with; it does not override an administrator who has already changed it.

# ------------------------------------------------------------- calling home

# Whether the framework reports this installation to gofr.dev. It defaults to
# true, so leaving the line out is as much a decision as changing it.
#
# At true the process POSTs to https://gofr.dev/api/ping/up when it starts and
# to .../ping/down when it shuts down, and sends a document to
# https://gofr.dev/telemetry/v1/metrics at every start: the application name
# and version, the framework and Go version, the operating system and the
# architecture. No recorded time and no account of anybody's is in any of it.
#
# false stops all three, and it is the first line to change on an air-gapped
# or egress-filtered host. The calls fail quietly there, so nothing draws
# attention to them - they are simply outbound connections nobody asked for.
# There is no screen for this: the framework has already sent the first one by
# the time a screen exists.
GOFR_TELEMETRY=true

# ------------------------------------------------------------------ process

# Shown in the browser tab and beside a two-factor account in an authenticator
# app, until an administrator sets a title under Settings.
APP_NAME=Time Recording

# The port the application - and, before it, the installer - listens on.
HTTP_PORT=8000

# How much the process writes: DEBUG, INFO, NOTICE, WARN, ERROR or FATAL.
# Anything else is read as INFO rather than refused.
#
# Not set here, and cmd/configs/.env no longer sets it either. It is administered
# under Settings, on the logging card, and what is stored there is exported into
# the environment before the framework starts - so a value written here is the
# losing half of a disagreement that nothing on screen would explain. Left empty
# the built-in INFO applies. Set it only to choose what a fresh installation
# starts on, before anybody has opened that screen.
#
# Either way it takes effect at a start, never while running: the framework
# changes a logger's level by writing a field every request goroutine reads
# without synchronisation.
#LOG_LEVEL=

# Keeps the two probe endpoints out of the request log, /.well-known/health and
# /.well-known/alive. Worth true wherever a load balancer polls them every few
# seconds, which is enough to bury everything else that was logged.
#LOG_DISABLE_PROBES=false

# How long a shutdown waits for requests in flight before the process exits.
SHUTDOWN_GRACE_PERIOD=30s

# A deadline on every request, in whole seconds - a plain number, not a
# duration, so "30s" here is refused with a line in the log and then ignored,
# which leaves no deadline at all. Unset is what this application runs with:
# nothing it serves is slow on purpose, but a directory synchronisation an
# administrator starts by hand answers when the directory does.
#REQUEST_TIMEOUT=

# The Prometheus endpoint, on a port of its own. 0 switches it off.
#
# Before exposing it: this port asks for no password, is not covered by TLS, and
# serves Go's profiling endpoints under /debug/pprof/ beside the metrics.
METRICS_PORT=2121

# APP_ENV selects an overlay file beside this one - configs/.prod.env for
# "prod" - and it is the one variable that cannot be set in this file. GoFr
# reads it from the real environment before it opens .env, so the overlay has
# already been chosen by the time anything written here is read: an APP_ENV
# line in this file selects nothing. It has to come from systemd, the shell,
# or docker run -e. No key is written below for that reason.
#
# A downloaded binary ships with no overlay files at all, so leaving it unset
# is the normal case. It is listed because a value inherited from the shell
# changes which file is read: a stage whose file exists is announced in the
# log, and one whose file is missing is skipped without a word.

# ----------------------------------------------------------------- database
#
# Deliberately empty. With a database configured here the binary starts the
# application; with nothing configured it serves the installer instead and waits
# until a connection has been chosen and proven to work. The installer writes it
# to configs/datasource.json, which wins over these from then on. Settings ->
# Database writes that same file later, so a connection moved there stops being
# described by anything below.
#
# A default here would be worse than none: the process would come up on a
# throwaway SQLite file, an installation would be built on it - accounts,
# projects, recorded hours - and the mistake would only surface on the day
# somebody moved to a real database and found it empty.

# sqlite, postgres or mysql.
DB_DIALECT=

# The database name. For SQLite it is a file path, created if it does not exist;
# for a server it must already exist.
DB_NAME=

# Server dialects only. DB_PORT may be left out: the application fills in the
# port the dialect is served on - 5432 for postgres, 3306 for mysql - and hands
# that to the database layer itself, so the port the pre-flight check proved is
# the port the connection uses. It is filled in here rather than left to the
# framework because GoFr defaults every dialect to 3306, which is how a
# PostgreSQL deployment that set everything but the port used to pass the check
# on 5432 and then dial MySQL's.
#DB_HOST=localhost
#DB_PORT=5432
#DB_USER=postgres
#DB_PASSWORD=
# Not PostgreSQL only, which is what this said and what the name suggests: the
# database layer turns it into a tls= parameter for MySQL as well - preferred,
# require and skip-verify ask for TLS, verify-ca and verify-full additionally
# check the certificate against DB_TLS_CA_CERT. disable and an empty value are
# plaintext. The pre-flight check speaks the same mode, so a connection asking
# for TLS is proven over TLS.
#DB_SSL_MODE=disable
# Connections kept open when idle, and the ceiling on open ones. 0 means no
# ceiling.
#DB_MAX_IDLE_CONNECTION=2
#DB_MAX_OPEN_CONNECTION=0
# MySQL only, and empty means utf8 - which in MySQL is three bytes per
# character and holds no emoji: a project name that does not fit is refused or
# truncated, depending on how strict the server is.
#DB_CHARSET=utf8mb4

# What the installer asks for before it will write a connection. Empty means one
# is generated and printed in this process's log at start, together with the URL
# to open - which is fine at a terminal and awkward for an unattended start, so
# set it there.
#SETUP_TOKEN=

# --------------------------------------------------------------- bootstrap
#
# Read only while the process starts, and not administrable from the interface:
# both of these can take away the screen that would put them back.

# Serve the embedded web interface. false runs the binary headless as an API.
UI_ENABLED=true

# Sign-in and role checks. false gives EVERY caller full administrative access,
# which suits a throwaway local trial and nothing else.
AUTH_ENABLED=true

# On first start the built-in administrator admin@local is created with the
# password "changeme123", and the setup wizard requires it to be changed before
# anything else can be used.

# --------------------------------------------------------------------- TLS
#
# Only needed when the binary terminates TLS itself. With a reverse proxy in
# front of it, leave TLS_ENABLED false and let the proxy do it - two
# certificates for one name means one renewal that quietly stops working.

# The listener is bound at start-up, so a wrong value here makes the instance
# unreachable rather than merely wrong.
TLS_ENABLED=false

# Required when TLS_ENABLED is true, comma separated, and with no sensible
# default: without it the application logs an error and carries on over plain
# HTTP, so enabling TLS without naming a domain achieves nothing. The name has
# to resolve to this machine publicly and TLS_REDIRECT_PORT has to be reachable,
# because that is where Let's Encrypt's challenge arrives.
#TLS_DOMAINS=time.example.com

# Where the certificate authority sends expiry warnings. Worth a real mailbox:
# it is the only notice that renewal has stopped working.
#TLS_EMAIL=ops@example.com

TLS_PORT=443
TLS_REDIRECT_PORT=80

# Issued certificates are kept here so a restart does not ask for new ones and
# run into the rate limit - five per domain per week, after which the site has
# no certificate at all.
TLS_CACHE_DIR=configs/certs

# Let's Encrypt's test authority: browsers do not trust those certificates, but
# the rate limits are far looser while setting a deployment up.
TLS_STAGING=false

# How long browsers refuse plain HTTP for this host. Only ever sent over a
# connection that already is HTTPS - over plain HTTP it could lock a host out of
# working at all.
HSTS_MAX_AGE=8760h

# A certificate of your own instead of Let's Encrypt: with both named, the
# framework serves HTTP_PORT over TLS itself. They are read once, so a renewed
# certificate is picked up at the next start and not before.
#
# Not to be combined with TLS_ENABLED=true. That listener terminates TLS in
# front and forwards to 127.0.0.1 in plain HTTP, which a TLS listener does not
# answer - the instance would be reachable on neither port.
#CERT_FILE=
#KEY_FILE=

# ------------------------------------------------------- scheduled directory
#
# Cron jobs are registered once at start-up and cannot be re-registered while
# running, which is why the schedule stays here while its parameters do not.

# Empty disables the scheduled run. A run DELETES accounts the directory no
# longer holds, together with their recorded time, private projects and tokens,
# and that cannot be undone - so it is off until somebody asks for it. An
# administrator can still start a run by hand, with a preview first.
#LDAP_SYNC_SCHEDULE=0 4 * * *

# Refuses a run that would remove more than this share of the directory-backed
# accounts - the guard against a truncated or misfiltered directory answer
# reading as a mass departure. 0 disables the check.
#
# Administered under Settings like the limits below, and raised from there
# without a restart, which is what you want in the middle of a refused run.
# Empty leaves the built-in 0.5.
#LDAP_SYNC_MAX_DELETE_RATIO=

# The LDAP connection itself is deliberately absent: it is administered entirely
# in the running application under Settings, and a second place to write it would
# only disagree with the first. So is the timezone.

# ------------------------------------------- the limits, set under Settings
#
# Named here so they can be found, and deliberately not set. All four are
# administered on the "operation and limits" card, take effect within seconds
# without a restart, and what is stored there wins over anything written here -
# so a value in this file is only ever what a fresh installation begins with,
# before anybody has opened that screen. Empty leaves the figure built into the
# binary, which is where these numbers used to be repeated from.
#
# Uncomment one only if you are provisioning an installation that should start
# somewhere other than the built-in default.

# How long a sign-in lasts before the user has to authenticate again.
#SESSION_LIFETIME=

# The cap on hours one user may book on a single day.
#MAX_DAILY_HOURS=

# Sign-in and API-token requests allowed per client per window. Generous enough
# for a script polling the API, tight enough that guessing a password is
# hopeless.
#RATE_LIMIT=
#RATE_LIMIT_WINDOW=

# ------------------------------------------------------- tracing (optional)
#
# Off unless an exporter is named. Administered under Settings as well, where
# what is saved wins from the next start onwards - so set it in one place or the
# other, not both.
#
# TRACER_URL is the collector as host:port without a scheme: the exporter speaks
# OTLP over gRPC, and a "http://" in front is read as part of the host name and
# resolves nothing. TRACER_RATIO is the share of traces recorded, between 0 and
# 1; a value it cannot read samples nothing rather than everything.

# otlp or jaeger.
#TRACE_EXPORTER=otlp
#TRACER_URL=jaeger:4317
#TRACER_RATIO=1

# For a collector that wants credentials. TRACER_HEADERS is a comma separated
# list of key=value pairs sent with every export; TRACER_AUTH_KEY is the short
# form for a single Authorization header, and is ignored where TRACER_HEADERS
# is set. Neither is administrable, unlike the three above.
#TRACER_HEADERS=Authorization=Bearer xyz
#TRACER_AUTH_KEY=Bearer xyz

# TRACER_HOST and TRACER_PORT are the older way of naming the collector, read
# only while TRACER_URL is empty and deprecated in the framework, which warns
# and carries on. TRACER_URL says the same thing in one value.

# ------------------------------------------------ the rest of the framework
#
# Read by GoFr in this build and exercised by nothing here, so they are named
# rather than given entries: a search for one of them should end in an answer.
#
#   APP_VERSION - what /.well-known/health reports. The process exports its own
#     build version before the framework starts, and the real environment beats
#     this file, so whatever is written here is overwritten and never shown.
#   DB_TLS_CA_CERT, DB_TLS_CLIENT_CERT, DB_TLS_CLIENT_KEY - the certificates
#     GoFr's MySQL driver verifies a server with. The pre-flight check that
#     runs before it does not read them, so a connection that needs them is
#     opened by the application without having been proven first.
#
# Past those, GoFr configures Redis, Kafka, MQTT, Google Pub/Sub, gRPC, an LLM
# client and a hosted trace exporter of its own from variables of their own.
# None of that is wired up in this application, and naming any of it here has
# no effect whatsoever.
