# Copy to .env next to compose.yaml and fill in.
#
# The manual that explains what to do with it is OPERATIONS.md, beside this file.
#
#   cp .env.example .env
#
# This file is read by docker compose, not by the application: it carries only
# what the compose files interpolate. Running the downloaded binary instead of
# the image? Use .env.binary.example, which lists what this application reads,
# and names the framework's own variables that can still change a deployment.
#
# The passwords here are the only thing protecting the recorded working time of
# everyone in the installation. Generate them, do not invent them:
#
#   openssl rand -base64 24
#
# .env must not be committed anywhere. It sits on the server, readable by the
# user running Docker and nobody else:
#
#   chmod 600 .env

# ---------------------------------------------------------------- database

DB_NAME=go-time-recording
DB_USER=gtr

# Required. No default on purpose - compose refuses to start without it rather
# than quietly bringing up a database with a password someone can guess.
DB_PASSWORD=

# ----------------------------------------------------------------- version

# Which image to run. Pinned rather than following "latest", which moves under
# you on the next release: a container restarted at 3am would come back as a
# different version than the one that went down. Set it to the release being
# installed; removing the line falls back to "latest", which is the thing this
# avoids.
GTR_VERSION=v0.1.12

# Only needed for a fork or a private registry.
#GTR_IMAGE=ghcr.io/dennis-dko/go-time-recording

# ---------------------------------------------------------------- branding

# The starting title, and the name authenticator apps show beside a two-factor
# account. From the moment an administrator sets a title under Settings the
# stored one names the instance; the two-factor issuer keeps reading this.
APP_NAME=Time Recording

# --------------------------------------------------------------------- TLS
#
# Only read when compose.tls.yaml is included. Leave commented out when a
# reverse proxy terminates TLS instead.
#
# BOTH are required with that overlay, not just the domain: compose interpolates
# them with the error form, so it refuses to start anything while either is
# missing. TLS_EMAIL is where Let's Encrypt sends expiry warnings, which is the
# only notice that renewal has stopped working - so it is worth a real mailbox
# rather than a name nobody reads.
#
# TLS_DOMAINS has to resolve to this server publicly, and port 80 has to be
# reachable from the internet: that is where the challenge arrives.

#TLS_DOMAINS=time.example.com
#TLS_EMAIL=ops@example.com
